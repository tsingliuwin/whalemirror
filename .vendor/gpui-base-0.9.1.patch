+        })
+        // [up 0.9.1] 表体行悬停底色（web 行 hover；表头不悬停）。上游
+        // `when_some(table_row_hover, …)` 同语义，此处并入行装饰器。
+        .when(!header, |this| {
+            this.when_some(style.table_row_hover(), |this, color| {
+                this.hover(|this| this.bg(color))
+            })
+        })
+}
 
