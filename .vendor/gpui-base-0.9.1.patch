+/// 单元格公共装饰（内距/字号/字重/对齐）。web 侧没有竖分隔线，故不画边框；
+/// 表头只加 500 字重，不铺底色。
+fn decorate_table_cell(
+    div: Div,
+    style: &TextViewStyle,
+    align: ColumnumnAlign,
+    ix: usize,
+    col_count: usize,
+    header: bool,
+) -> Div {
+    div.overflow_hidden()
+        // [dsh+up 0.9.1] 对齐内容盒而非文本：GPUI 的 text_align 绘制偏移
+        // 不被 TextLayout 命中测试覆盖——flex 列对齐让选中热区与视觉一致。
+        .when(align == ColumnumnAlign::Center, |this| {
+            this.flex().flex_col().items_center()
+        })
+        .when(align == ColumnumnAlign::Right, |this| {
+            this.flex().flex_col().items_end()
+        })
+        .when(ix != 0, |this| this.pl(px(TABLE_CELL_PAD_X_PX)))
+        .when(ix + 1 != col_count, |this| this.pr(px(TABLE_CELL_PAD_X_PX)))
+        .pt(px(TABLE_CELL_PAD_Y_PX))
+        .pb(px(TABLE_CELL_PAD_Y_PX))
+        .text_size(px(TABLE_FONT_SIZE_PX))
+        .line_height(px(TABLE_LINE_HEIGHT_PX))
+        .font_weight(if header {
+            FontWeight::MEDIUM
+        } else {
+            FontWeight::NORMAL
+        })
+        .refine_style(&style.table_cell())
